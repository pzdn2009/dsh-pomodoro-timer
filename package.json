{
  "name": "@local/pomodoro-timer",
  "version": "1.0.0",
  "private": true,
  "description": "A floating Pomodoro focus timer for the DeepSeek Harness window.",
  "license": "MIT",
  "author": "Zhen Peng",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "pomodoro",
    "timer",
    "focus"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzdn2009/dsh-pomodoro-timer.git"
  },
  "homepage": "https://github.com/pzdn2009/dsh-pomodoro-timer#readme",
  "bugs": {
    "url": "https://github.com/pzdn2009/dsh-pomodoro-timer/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
